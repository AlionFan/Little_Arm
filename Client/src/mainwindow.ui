  <property name="styleSheet">
   <string notr="true">* {
    color: #000000;
}
QMainWindow {
    background-color: #f0f0f0;
}
QGroupBox {
    border: 2px solid #cccccc;
    border-radius: 6px;
    margin-top: 1ex;
    font-weight: bold;
    background-color: #ffffff;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 3px;
    color: #000000;
}
QPushButton {
    background-color: #0078d4;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 5px 15px;
    min-height: 25px;
    font-weight: bold;
}
QPushButton:hover {
    background-color: #1084d8;
}
QPushButton:pressed {
    background-color: #006cbd;
}
QLineEdit {
    padding: 4px;
    border: 1px solid #cccccc;
    border-radius: 4px;
    background-color: white;
    color: #000000;
}
QTextEdit {
    border: 1px solid #cccccc;
    border-radius: 4px;
    background-color: white;
    color: #000000;
}
QLabel {
    color: #000000;
    font-weight: bold;
}
QCheckBox {
    color: #000000;
}
QSpinBox {
    color: #000000;
    background-color: white;
    padding: 4px;
    border: 1px solid #cccccc;
    border-radius: 4px;
}
QSlider::groove:horizontal {
    border: 1px solid #999999;
    height: 8px;
    background: #ffffff;
    margin: 2px 0;
    border-radius: 4px;
}
QSlider::handle:horizontal {
    background: #0078d4;
    border: none;
    width: 18px;
    margin: -5px 0;
    border-radius: 9px;
}
QSlider::handle:horizontal:hover {
    background: #1084d8;
}
QTabWidget::pane {
    border: 1px solid #cccccc;
    border-radius: 4px;
    background-color: white;
}
QTabBar::tab {
    background-color: #f0f0f0;
    border: 1px solid #cccccc;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 8px 16px;
    margin-right: 2px;
    color: #000000;
}
QTabBar::tab:selected {
    background-color: white;
    color: #000000;
    font-weight: bold;
}
QTabBar::tab:hover {
    background-color: #e5e5e5;
}
QStatusBar {
    color: #000000;
}
QPushButton[objectName^=&quot;presetButton&quot;] {
    background-color: #5c2d91;
    color: white;
    min-width: 100px;
    font-weight: bold;
}
QPushButton[objectName^=&quot;presetButton&quot;]:hover {
    background-color: #6b3a9e;
}
QPushButton[objectName^=&quot;presetButton&quot;]:pressed {
    background-color: #4c2277;
}</string>
